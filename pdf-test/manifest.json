{
  "manifest_version": 3,
  "name": "LMS Helper (MVP)",
  "version": "0.1.0",
  "action": {
    "default_title": "Open LMS Helper"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "background": {
    "service_worker": "src/background.jsx", 
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://lms.ssn.edu.in/*"],
      "js": ["src/content.jsx"]
    }
  ],
  "permissions": ["storage", "sidePanel", "activeTab", "scripting", "downloads", "identity"],
  "host_permissions": ["https://lms.ssn.edu.in/*",
    "https://www.googleapis.com/*",
    "http://localhost:5000/*"
  ],
  "oauth2": {
    "client_id": "758127203338-ui7uaed6cbqgbcitc9jjk2h4sg382ra9.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive.file",
      "https://www.googleapis.com/auth/userinfo.email",
      "https://www.googleapis.com/auth/userinfo.profile"
    ]
  }
}