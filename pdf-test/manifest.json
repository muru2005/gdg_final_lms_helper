{
  "manifest_version": 3,
  "name": "LMS Helper (MVP)",
  "version": "0.1.3",
  "action": {
    "default_title": "Open LMS Helper"
  },
  "background": {
    "service_worker": "src/background.jsx", 
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://lms.ssn.edu.in/*"],
      "js": ["src/content.jsx"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["pdf.worker.mjs"],
      "matches": ["https://lms.ssn.edu.in/*"]
    }
  ],
  "permissions": [
    "storage", 
    "sidePanel", 
    "activeTab", 
    "identity",
    "scripting",
    "notifications",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://lms.ssn.edu.in/*",
    "https://www.googleapis.com/*",
    "http://10.31.25.153:5000/*",
    "http://localhost:5000/*",
    "http://192.168.1.6:5000/*"
  ],
  "side_panel": {
    "default_path": "index.html"
  },
  "oauth2": {
    "client_id": "758127203338-ui7uaed6cbqgbcitc9jjk2h4sg382ra9.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive.file",
      "https://www.googleapis.com/auth/userinfo.email",
      "https://www.googleapis.com/auth/userinfo.profile",
      "https://www.googleapis.com/auth/calendar",
      "https://www.googleapis.com/auth/gmail.readonly",
      "https://www.googleapis.com/auth/forms.body"
    ]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}